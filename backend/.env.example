# Production example. Copy these names into the Vercel dashboard; do not commit real values.
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# Public origins: no trailing slash, no path, no query, no wildcard.
FrontendOrigin=https://emtehani.vercel.app
# Base API origin only; the verification link appends /api/auth/verify-email.
PublicApiUrl=https://emtehani-api.vercel.app

# Use one database option. Prefer DATABASE_URL for Neon Postgres.
DATABASE_URL=postgres://user:change-me@your-neon-host/your-database?sslmode=require
# ConnectionStrings__DefaultConnection=Server=...;Database=...;User Id=...;Password=...;

# Use a cryptographically random value with at least 32 characters.
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
# JWT_KEY=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=Emtehani
Jwt__Audience=Emtehani.Client

Auth__AutoConfirmWithoutSmtp=false

Email__From=no-reply@example.com
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=replace-with-smtp-username
Email__Password=replace-with-smtp-app-password
Email__EnableSsl=true

Swagger__Enabled=false

# Admin reset endpoint is disabled in production by default.
# Set Admin__ResetEnabled=true only for emergency use.
Admin__ResetEnabled=false
